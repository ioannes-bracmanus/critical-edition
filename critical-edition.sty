}

\NewDocumentCommand{\footA}{o m m}{%
	\global\advance\CE@footA@count by 1\relax
	\begingroup
	\global\let\CE@footA@temp@altlemma\relax
	\global\let\CE@footA@temp@ad\relax
	\def\lemma##1{\gdef\CE@footA@temp@altlemma{##1}}%
	\IfValueTF{#1}{%
		\setkeys{CE@footAopt}{#1}%
	}{}%
	\setbox0=\hbox{#2}%
	\endgroup
	\begingroup
	\def\lemma##1{\unskip}%
	#2%
	\endgroup
	\csgdef{footA@var@\the\CE@bnumcount @\the\CE@footA@count}{#3}%
	\ifx\CE@footA@temp@altlemma\relax
	\csgdef{footA@lem@\the\CE@bnumcount @\the\CE@footA@count}{#2}%
	\else
	\csxdef{footA@lem@\the\CE@bnumcount @\the\CE@footA@count}{\unexpanded\expandafter{\CE@footA@temp@altlemma}}%
	\fi
	\ifx\CE@footA@temp@ad\relax
	\else
	\csxdef{footA@endline@\the\CE@bnumcount @\the\CE@footA@count}{\unexpanded\expandafter{\CE@footA@temp@ad}}%
	\fi
	\protected@write\@auxout{}{%
		\string\scFootAAssoc{\the\CE@bnumcount}{\the\CE@footA@count}{0pt}%
	}%
}

\newcommand{\samelineseparatorA}{\char"02016}
\newcommand{\lemmaseparatorA}{]}

\newcommand{\print@footA@entry}[2]{%
	\begingroup
	\footfontsize
	\ifcsdef{footA@line@#1@#2}{%
		\def\line@ref{\csuse{footA@line@#1@#2}}%
	}{%
		\def\line@ref{??}%
	}%
	\ifcsdef{footA@endline@#1@#2}{%
		\edef\line@ref@end{\csuse{footA@endline@#1@#2}}%
	}{%
		\let\line@ref@end\empty
	}%
	\def\lemma##1{\unskip}% 
	\def\the@lemma{\csuse{footA@lem@#1@#2}}%
	\def\the@variant{\csuse{footA@var@#1@#2}}%
	\ifx\line@ref@end\empty
	\ifcsvoid{CE@last@printed@line}{%
		\def\print@ref{\textbf{\line@ref}}%
	}{%
		\edef\current@line@sig{#1@\line@ref}%
		\ifx\CE@last@printed@line\current@line@sig
		\def\print@ref{\textbf{\samelineseparatorA}\enskip}%
		\else
		\def\print@ref{\textbf{\line@ref}}%
		\fi
	}%
	\csxdef{CE@last@printed@line}{#1@\line@ref}%
	\else
	\def\print@ref{\textbf{\line@ref--\line@ref@end}}%
	\global\let\CE@last@printed@line\empty
	\fi
	\print@ref\space
	\ifcsvoid{footA@lem@#1@#2}{%
		\the@variant
	}{%
		\the@lemma\lemmaseparatorA\enskip \the@variant
	}%
	\quad\relax
	\endgroup
}

\gdef\CE@display@A{quad}

\newcommand{\foottype}[2][T]{%
	\ifboolexpr{ test {\ifstrequal{#2}{quad}} }{%
		\ifstrequal{#1}{T}{%
			\gdef\CE@display@T{#2}%
			\global\let\CE@noteTitem\CE@noteT@quad%
		}{}%
		\ifstrequal{#1}{E}{%
			\gdef\CE@display@E{#2}%
			\global\let\CE@noteEitem\CE@noteE@quad%
		}{}%
	}{%
		\ifstrequal{#1}{T}{%
			\gdef\CE@display@T{block}%
			\global\let\CE@noteTitem\CE@noteT@block%
		}{}%
		\ifstrequal{#1}{E}{%
			\gdef\CE@display@E{block}%
			\global\let\CE@noteEitem\CE@noteE@block%
		}{}%
	}%
}

% Foot format.
\newcommand{\CE@noteT@block}[2]{#1#2\par}
\newcommand{\CE@noteE@block}[2]{#1#2\par}
\newcommand{\CE@noteT@quad}[2]{#1#2\quad}
\newcommand{\CE@noteE@quad}[2]{#1#2\quad}

% Number print or not.
\newcommand{\thefootA}[1]{\textbf{#1}}
\renewcommand{\thefootT}{\arabic{footT}} 
\renewcommand{\thefootE}{\arabic{footE}} 

% Superscript body number appearance.
\newcommand{\footTcall}[1]{\textsuperscript{#1}}
\newcommand{\footEcall}[1]{\textsuperscript{#1}}

% Superscript foot number appearance.
\newcommand{\footTmark}[1]{\textbf{\textsuperscript{#1}}}
\newcommand{\footEmark}[1]{\textbf{\textsuperscript{#1}}}

\newcommand{\print@footT@marker}[2]{%
	\begingroup
	\setcounter{footT}{#2}%
	\checkdefempty{\thefootT}%
	{}%
	{{\footTmark{\thefootT}}\space}%
	\endgroup
}
\newcommand{\print@footE@marker}[2]{%
	\begingroup
	\setcounter{footE}{#2}%
	\checkdefempty{\thefootE}%
	{}%
	{{\footEmark{\thefootE}}\space}%
	\endgroup
}

\gdef\CE@display@T{block}     
\gdef\CE@display@E{block}     
\let\CE@noteTitem\CE@noteT@block
\let\CE@noteEitem\CE@noteE@block

% The footT (witnesses).
\NewDocumentCommand{\footT}{o m}{%
	\IfValueTF{#1}{%
		\setcounter{footT}{#1}%
	}{%
		\stepcounter{footT}%
	}%
	\checkdefempty{\thefootT}%
	{}%
	{{\footTcall{\thefootT}}}
	\begingroup
	\ifbool{CE@numberedpar}{%
		\csgdef{footT@text@\the\CE@bnumcount @\the\value{footT}}{#2}%
		\protected@write\@auxout{}{%
			\string\scFootTAssoc{\the\CE@bnumcount}{\the\value{footT}}{0pt}%
		}%
	}{%
		\comparedisplay{\CE@display@T}{quad}%
		{%
			\begingroup
			\setbox0=\hbox{\footfontsize\CE@noteTitem{\print@footT@marker{\the\CE@bnumcount}{\the\value{footT}}}{\unexpanded{#2}}}%
			\dp0=0pt\relax
			\ht0=\CE@fudgefactor\wd0\relax
			\insert\footTins{\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\box0\penalty -50}%
			\endgroup
		}%
		{%
			\insert\footTins{%
				\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footTparindent\hangindent=\footThangindent
				\vskip 2pt %
				\CE@noteTitem{\print@footT@marker{\the\CE@bnumcount}{\the\value{footT}}}{\unexpanded{#2}}%
			}%
		}%
	}%
	\endgroup
}

% The footE (explanations).
\NewDocumentCommand{\footE}{o +m}{%
	\IfValueTF{#1}{%
		\setcounter{footE}{#1}%
	}{%
		\stepcounter{footE}%
	}%
	\checkdefempty{\thefootE}%
	{}%
	{{\footEcall{\thefootE}}}%
	\begingroup
	\ifbool{CE@numberedpar}{%
		\csgdef{footE@text@\the\CE@bnumcount @\the\value{footE}}{#2}%
		\protected@write\@auxout{}{%
			\string\scFootEAssoc{\the\CE@bnumcount}{\the\value{footE}}{0pt}%
		}%
	}{%
		\comparedisplay{\CE@display@E}{quad}%
		{%
			\begingroup
			\setbox0=\hbox{\footfontsize\CE@noteEitem{\print@footE@marker{\the\CE@bnumcount}{\the\value{footE}}}{\unexpanded{#2}}}%
			\dp0=0pt\relax
			\ht0=\CE@fudgefactor\wd0\relax
			\insert\footEins{\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\box0\penalty -50}%
			\endgroup
		}%
		{%
			\insert\footEins{%
				\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footEparindent\hangindent=\footEhangindent
				\vskip 2pt %
				\CE@noteEitem{\print@footE@marker{\the\CE@bnumcount}{\the\value{footE}}}{\unexpanded{#2}}%
