% Redefine the line in the counter system.
\newcommand{\setotherline}[1]{%
	\global\CE@line@num=#1\relax
	\global\advance\CE@line@num by -1\relax
}

\newcommand{\print@line}{%
	\checklinemargin%
	\hbox to \textwidth{%
		\protected@write\@auxout{}{%
			\string\scLinePage{\the\CE@bnumcount}{\the\CE@line@num}{\the\c@page}%
		}%
		\protected@write\@auxout{}{%
			\string\scNL{\the\CE@bnumcount}{\the\CE@line@num}%
		}%
		\make@margin@number
		\ifcsdef{line@footT@trigger@\the\CE@bnumcount @\the\CE@line@num}{\csuse{line@footT@trigger@\the\CE@bnumcount @\the\CE@line@num}}{}%
		\ifcsdef{line@footA@trigger@\the\CE@bnumcount @\the\CE@line@num}{\csuse{line@footA@trigger@\the\CE@bnumcount @\the\CE@line@num}}{}%
		\ifcsdef{line@footE@trigger@\the\CE@bnumcount @\the\CE@line@num}{\csuse{line@footE@trigger@\the\CE@bnumcount @\the\CE@line@num}}{}%
		\kern\dimexpr\textwidth-\wd\CE@one@line\relax
		\unhbox\CE@one@line
	}%
}

\newcommand{\numlabfont}{\normalfont\scriptsize}

\newcommand{\printlinenum}[1]{%
	\global\csgdef{CE@force@line@\the\CE@bnumcount @#1}{1}%
}

\newcommand{\make@margin@number}{% Print margin numbers of counter.
	\def\force@print@this{0}%
	\ifcsdef{CE@force@line@\the\CE@bnumcount @\the\CE@line@num}{%
		\def\force@print@this{1}%
	}{}%
	\def\do@print@num{0}%
	\@tempcnta=\CE@line@num
	\divide\@tempcnta by 5\relax
	\multiply\@tempcnta by 5\relax
	\ifnum\@tempcnta=\CE@line@num\relax
	\def\do@print@num{1}%
	\fi
	\ifnum\force@print@this=1\relax
	\def\do@print@num{1}%
	\fi
	\ifnum\do@print@num=1\relax
	\ifnum\CE@line@num>0\relax
	\iftoggle{CE@lineonleft}{%
		% Left side.
		\llap{%
			\numlabfont\the\CE@line@num
			\kern\leftlinenumsep
		}%
	}{%
		% Right side.
		\kern\textwidth
		\rlap{%
			\kern\rightlinenumsep
			\numlabfont\the\CE@line@num
		}%
		\kern-\textwidth
	}%
	\fi
	\fi
}

