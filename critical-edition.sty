% Checking dynamic ubication of margin numbers.
\newcommand{\checklinemargin}{%
	\toggletrue{CE@lineonleft}%
	\ifcsdef{CE@linepage@\the\CE@bnumcount @\the\CE@line@num}{%
		\edef\CE@thispage{\csuse{CE@linepage@\the\CE@bnumcount @\the\CE@line@num}}%
	}{%
		\edef\CE@thispage{\thepage}%
	}%
	\ifdefstring{\CE@linenummargin}{right}{\togglefalse{CE@lineonleft}}{}%
	\ifdefstring{\CE@linenummargin}{inner}{%
		\ifodd\CE@thispage\relax%
		\toggletrue{CE@lineonleft}%
		\else%
		\togglefalse{CE@lineonleft}%
		\fi%
	}{}%
	\ifdefstring{\CE@linenummargin}{outer}{%
		\ifodd\CE@thispage\relax%
		\togglefalse{CE@lineonleft}%
		\else%
		\toggletrue{CE@lineonleft}%
		\fi%
	}{}%
}

