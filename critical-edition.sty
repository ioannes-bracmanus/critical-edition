% Redefine the line in the counter system.
\newcommand{\setotherline}[1]{%
	\global\line@num=#1\relax
	\global\advance\line@num by -1\relax
}

\newcommand{\print@line}{%
	\checklinemargin%
	\hbox to \textwidth{%
		%
		\edef\next{\write\@auxout{\string\scLinePage{\the\bnumcount}{\the\line@num}{\noexpand\number\c@page}}}%
		\next
		%
		\edef\next{\write\@auxout{\string\scNL{\the\bnumcount}{\the\line@num}}}%
		\next
		%
		\make@margin@number
		%
		\ifcsdef{line@footT@trigger@\the\bnumcount @\the\line@num}{\csuse{line@footT@trigger@\the\bnumcount @\the\line@num}}{}%
		\ifcsdef{line@footA@trigger@\the\bnumcount @\the\line@num}{\csuse{line@footA@trigger@\the\bnumcount @\the\line@num}}{}%
		\ifcsdef{line@footE@trigger@\the\bnumcount @\the\line@num}{\csuse{line@footE@trigger@\the\bnumcount @\the\line@num}}{}%
		%
		\kern\dimexpr\textwidth-\wd\one@line\relax
		\unhbox\one@line
	}%
}

\newcommand{\numlabfont}{\normalfont\scriptsize}

\newcommand{\printlinenum}[1]{%
	\global\csgdef{EC@force@line@\the\bnumcount @#1}{1}%
}

\newcommand{\make@margin@number}{% Print margin numbers of counter.
	\def\force@print@this{0}%
	\ifcsdef{EC@force@line@\the\bnumcount @\the\line@num}{%
		\def\force@print@this{1}%
	}{}%
	%
	\def\do@print@num{0}%
	\@tempcnta=\line@num
	\divide\@tempcnta by 5\relax
	\multiply\@tempcnta by 5\relax
	\ifnum\@tempcnta=\line@num\relax
	\def\do@print@num{1}%
	\fi
	% If exist \printlinenum{}.
	\ifnum\force@print@this=1\relax
	\def\do@print@num{1}%
	\fi
	%
	\ifnum\do@print@num=1\relax
	\ifnum\line@num>0\relax
	\iftoggle{lineonleft}{%
		% Left side.
		\llap{%
			\numlabfont\the\line@num
			\kern\leftlinenumsep
		}%
	}{%
		% Right side.
		\kern\textwidth
		\rlap{%
			\kern\rightlinenumsep
			\numlabfont\the\line@num
		}%
		\kern-\textwidth
	}%
	\fi
	\fi
}

% The lemma and footA.
\newcommand{\lemma}[1]{%
	\gdef\footA@temp@altlemma{#1}%
}

\NewDocumentCommand{\footA}{o m m}{%
	\global\advance\footA@count by 1\relax
	\begingroup
	\global\let\footA@temp@altlemma\relax
	\global\let\footA@temp@ad\relax
	\def\lemma##1{\gdef\footA@temp@altlemma{##1}}%
	\IfValueTF{#1}{%
		\setkeys{footAopt}{#1}%
	}{}%
	% If lemma exist.
	\setbox0=\hbox{#2}%
	\endgroup
	%
	\begingroup
	\def\lemma##1{\unskip}%
	#2%
	\endgroup
	%
	% Saving variants.
	\csgdef{footA@var@\the\bnumcount @\the\footA@count}{#3}%
	%
	\ifx\footA@temp@altlemma\relax
	% If doesn't use the macro \lemma{}, the default lemma is #2
	\csgdef{footA@lem@\the\bnumcount @\the\footA@count}{#2}%
	\else
	%
	\csxdef{footA@lem@\the\bnumcount @\the\footA@count}{\unexpanded\expandafter{\footA@temp@altlemma}}%
	\fi
	%
	\ifx\footA@temp@ad\relax
	\else
	\csxdef{footA@endline@\the\bnumcount @\the\footA@count}{\unexpanded\expandafter{\footA@temp@ad}}%
	\fi
	%
	\edef\act{%
		\noexpand\write\noexpand\@auxout{\string\scFootAAssoc{\the\bnumcount}{\the\footA@count}{0pt}}%
	}%
	\act
}

\newcommand{\samelineseparatorA}{\char"02016}
\newcommand{\lemmaseparatorA}{]}

%
\newcommand{\print@footA@entry}[2]{%
	\begingroup
	\footfontsize
	\ifcsdef{footA@line@#1@#2}{%
		\def\line@ref{\csuse{footA@line@#1@#2}}%
	}{%
		\def\line@ref{??}%
	}%
	\ifcsdef{footA@endline@#1@#2}{%
		\edef\line@ref@end{\csuse{footA@endline@#1@#2}}%
	}{%
		\let\line@ref@end\empty
	}%
	%
	\def\lemma##1{\unskip}% 
	\def\the@lemma{\csuse{footA@lem@#1@#2}}%
	\def\the@variant{\csuse{footA@var@#1@#2}}%
	\ifx\line@ref@end\empty
	\ifcsvoid{last@printed@line}{%
		\def\print@ref{\textbf{\line@ref}}%
	}{%
		\edef\current@line@sig{#1@\line@ref}%
		\ifx\last@printed@line\current@line@sig
		\def\print@ref{\textbf{\samelineseparatorA}\enskip}%
		\else
		\def\print@ref{\textbf{\line@ref}}%
		\fi
	}%
	\csxdef{last@printed@line}{#1@\line@ref}%
	\else
	\def\print@ref{\textbf{\line@ref--\line@ref@end}}%
	\global\let\last@printed@line\empty
	\fi
	\print@ref\space
	\ifcsvoid{footA@lem@#1@#2}{%
		\the@variant
	}{%
		\the@lemma\lemmaseparatorA\enskip \the@variant
	}%
	\quad\relax
	\endgroup
}

\gdef\EC@display@A{quad} % Apparatus criticus always is quad.

% Normal footnotes: footT and footE.%
% The macro \foottype[T/E]{quad/block} activate quad.
\newcommand{\foottype}[2][T]{%
	\ifboolexpr{ test {\ifstrequal{#2}{quad}} }{%
		\ifstrequal{#1}{T}{%
			\gdef\EC@display@T{#2}%
			\global\let\EC@noteTitem\EC@noteT@quad%
		}{}%
		\ifstrequal{#1}{E}{%
			\gdef\EC@display@E{#2}%
			\global\let\EC@noteEitem\EC@noteE@quad%
		}{}%
	}{%
		\ifstrequal{#1}{T}{%
			\gdef\EC@display@T{block}%
			\global\let\EC@noteTitem\EC@noteT@block%
		}{}%
		\ifstrequal{#1}{E}{%
			\gdef\EC@display@E{block}%
			\global\let\EC@noteEitem\EC@noteE@block%
		}{}%
	}%
}

% Foot format.
\newcommand{\EC@noteT@block}[2]{#1#2\par}
\newcommand{\EC@noteE@block}[2]{#1#2\par}
\newcommand{\EC@noteT@quad}[2]{#1#2\quad}
\newcommand{\EC@noteE@quad}[2]{#1#2\quad}

% Number print or not.
\newcommand{\thefootA}[1]{\textbf{#1}}
\renewcommand{\thefootT}{\arabic{footT}} 
\renewcommand{\thefootE}{\arabic{footE}} 

% Superscript body number appearance.
\newcommand{\footTcall}[1]{\textsuperscript{#1}}
\newcommand{\footEcall}[1]{\textsuperscript{#1}}

% Superscript foot number appearance.
\newcommand{\footTmark}[1]{\textbf{\textsuperscript{#1}}}
\newcommand{\footEmark}[1]{\textbf{\textsuperscript{#1}}}

%
\newcommand{\print@footT@marker}[2]{%
	\begingroup
	\setcounter{footT}{#2}%
	\checkdefempty{\thefootT}%
	{}%
	{{\footTmark{\thefootT}}\space}%
	\endgroup
}
\newcommand{\print@footE@marker}[2]{%
	\begingroup
	\setcounter{footE}{#2}%
	\checkdefempty{\thefootE}%
	{}%
	{{\footEmark{\thefootE}}\space}%
	\endgroup
}

\gdef\EC@display@T{block}     
\gdef\EC@display@E{block}     
\let\EC@noteTitem\EC@noteT@block
\let\EC@noteEitem\EC@noteE@block

% The footT (witnesses).
\NewDocumentCommand{\footT}{o m}{%
	\IfValueTF{#1}{%
		\setcounter{footT}{#1}%
	}{%
		\stepcounter{footT}%
	}%
	\checkdefempty{\thefootT}%
	{}%
	{{\footTcall{\thefootT}}}
	\begingroup
	\ifbool{numberedpar}{%
		\csgdef{footT@text@\the\bnumcount @\the\value{footT}}{#2}%
		\edef\act{%
			\noexpand\write\noexpand\@auxout{\string\scFootTAssoc{\the\bnumcount}{\the\value{footT}}{0pt}}%
		}%
		\act
	}{%
		\comparedisplay{\EC@display@T}{quad}%
		{%
			\begingroup
			\setbox0=\hbox{\footfontsize\EC@noteTitem{\print@footT@marker{\the\bnumcount}{\the\value{footT}}}{\unexpanded{#2}}}%
			\dp0=0pt\relax
			\ht0=\EC@fudgefactor\wd0\relax
			\insert\footTins{\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\box0\penalty -50}%
			\endgroup
		}%
		{%
			\insert\footTins{%
				\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footTparindent\hangindent=\footThangindent
				\vskip 2pt %
				\EC@noteTitem{\print@footT@marker{\the\bnumcount}{\the\value{footT}}}{\unexpanded{#2}}%
			}%
		}%
	}%
	\endgroup
}

%The footE (explanations).
\NewDocumentCommand{\footE}{o +m}{%
	\IfValueTF{#1}{%
		\setcounter{footE}{#1}%
	}{%
		\stepcounter{footE}%
	}%
	\checkdefempty{\thefootE}%
	{}%
	{{\footEcall{\thefootE}}}%
	\begingroup
	\ifbool{numberedpar}{%
		\csgdef{footE@text@\the\bnumcount @\the\value{footE}}{#2}%
		\edef\act{%
			\noexpand\write\noexpand\@auxout{\string\scFootEAssoc{\the\bnumcount}{\the\value{footE}}{0pt}}%
		}%
		\act
	}{%
		\comparedisplay{\EC@display@E}{quad}%
		{%
			\begingroup
			\setbox0=\hbox{\footfontsize\EC@noteEitem{\print@footE@marker{\the\bnumcount}{\the\value{footE}}}{\unexpanded{#2}}}%
			\dp0=0pt\relax
			\ht0=\EC@fudgefactor\wd0\relax
			\insert\footEins{\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\box0\penalty -50}%
			\endgroup
		}%
		{%
			\insert\footEins{%
				\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footEparindent\hangindent=\footEhangindent
				\vskip 2pt % Inyecta separación elástica entre notas de explicatio consecutivas
				\EC@noteEitem{\print@footE@marker{\the\bnumcount}{\the\value{footE}}}{\unexpanded{#2}}%
			}%
		}%
	}%
	\endgroup
}

% "critgroup" enviroment for isolated footnotes in differents critical editions of fragments.
\newenvironment{critgroup}{%
	\edef\saved@footT{\the\value{footT}}%
	\edef\saved@footE{\the\value{footE}}%
	\setcounter{footT}{0}% Reset counters locally in critgroup.
	\setcounter{footE}{0}%
	\global\setbox\local@footTbox=\box\voidb@x
	\global\setbox\local@footAbox=\box\voidb@x
	\global\setbox\local@footEbox=\box\voidb@x
	\ifdefempty{\EC@grouplinenummargin}{}{%
		\let\EC@linenummargin\EC@grouplinenummargin
	}%
	\ifbool{group@nummarginsep@set}{%
		\leftlinenumsep=\groupleftlinenumsep
		\rightlinenumsep=\grouprightlinenumsep
	}{}%
	\let\normal@insert\insert
	\long\def\insert##1##2{%
		\ifx##1\footTins
		\global\setbox\local@footTbox=\vbox{%
			\unvbox\local@footTbox
			\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
			##2%
		}%
		\else\ifx##1\footAins
		\global\setbox\local@footAbox=\vbox{%
			\unvbox\local@footAbox
			\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
			##2%
		}%
		\else\ifx##1\footEins
		\global\setbox\local@footEbox=\vbox{%
			\unvbox\local@footEbox
			\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
			##2%
		}%
		\else
		\normal@insert##1{##2}%
		\fi\fi\fi
	}%
}{%
	\par
	\EC@printlocalnotes
	\setcounter{footT}{\saved@footT}%
	\setcounter{footE}{\saved@footE}%
}
