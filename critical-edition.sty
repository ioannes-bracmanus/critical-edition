%% Numbered paragraph.
\newcommand{\bnum}{% Open the environment.
	\global\absline@num=0
	\global\line@num=0
	\global\footA@count=0
	\boolfalse{numberedpar}%
	\global\advance\bnumcount by 1\relax%
	% Reseting counters for current compilation.
	\global\absline@num=0
	\global\line@num=0
	\global\footA@count=0
}

\newcommand{\enum}{% Close the environment.
}

\newcommand{\scNL}[2]{% #1 = bnumcount, #2 = line_num
	\csgdef{EC@line@#1}{#2}%
}

\newcommand{\scLinePage}[3]{%
	\csgdef{EC@linepage@#1@#2}{#3}%
}

\newcount\EC@chunkcount
\newbox\EC@dummybox
\newbox\EC@stackpatchA
\newbox\EC@stackpatchAA

\newcommand{\EC@stackset}[1]{%
	\ifcase#1\or
	\global\setbox\EC@stackpatchA=\box\one@line\or
	\global\setbox\EC@stackpatchAA=\box\one@line\fi
}
\newcommand{\EC@stackget}[1]{%
	\ifcase#1\or
	\global\setbox\one@line=\box\EC@stackpatchA\or
	\global\setbox\one@line=\box\EC@stackpatchAA\fi
}
\newcommand{\EC@drainchunk}{%
	\unskip\unpenalty\unkern
	\global\setbox\one@line=\lastbox
	\ifvoid\one@line
	\else
	\global\advance\EC@chunkcount by 1\relax
	\EC@stackset{\the\EC@chunkcount}%
	\EC@drainchunk
	\fi
}
\newcommand{\EC@printchunk}{%
	\ifnum\EC@chunkcount>0\relax
	\EC@stackget{\the\EC@chunkcount}%
	\global\advance\absline@num by 1\relax
	\global\advance\line@num by 1\relax
	\print@line
	\global\advance\EC@chunkcount by -1\relax
	\EC@printchunk
	\fi
}

\newcommand{\nstart}{% Open the numbered paragraph environment
	\par
	\global\booltrue{numberedpar}%
	\global\setbox\rawtext=\vbox\bgroup
	\hsize=\textwidth
	\parindent=\EC@savedparindent
	\parskip=\z@\relax
	\lineskiplimit=-1000pt
	\normalbaselines
	\topskip=\z@
	\brokenpenalty=\z@
	\clubpenalty=\z@
	\displaywidowpenalty=\z@
	\interlinepenalty=\z@
	\predisplaypenalty=\z@
	\postdisplaypenalty=\z@
	\widowpenalty=\z@
}

\newcommand{\nend}{% Close the numbered paragraph environment.
	\par
	\egroup 
	\global\boolfalse{numberedpar}%
	\begingroup
	\vbadness=10000
	\loop\ifvbox\rawtext
	{\splittopskip=\z@ 
		\global\setbox\one@line=\vsplit\rawtext to \baselineskip}%
	\EC@chunkcount=0\relax
	\setbox\EC@dummybox=\vbox{%
		\unvbox\one@line
		\EC@drainchunk
	}%
	\EC@printchunk
	\repeat
	\endgroup
}

