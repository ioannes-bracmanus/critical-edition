%
\newcommand{\footfudgefiddle}{64}
\newcommand{\EC@fudgefactor}{0.04} 

\newcommand*{\EC@setfudge}[2]{% #1 =save factor, #2 = coll width
	\begingroup
	\dimen0=\baselineskip
	\multiply\dimen0 by 1024\relax
	\divide\dimen0 by #2\relax
	\multiply\dimen0 by \footfudgefiddle\relax%
	\xdef#1{\strip@pt\dimen0}%
	\endgroup
}

% Quad format compiling.
\newcommand*{\EC@makehboxofhboxes}{%
	\global\setbox\footbox@temp=\hbox{}%
	\loop
	\unpenalty\unskip\unkern
	\setbox2=\lastbox
	\ifhbox2
	\global\setbox\footbox@temp=\hbox{\box2 \unhbox\footbox@temp}%
	\repeat
}

\newcommand*{\EC@removehboxes}{%
	\setbox0=\lastbox
	\ifhbox0{\EC@removehboxes}\unhbox0 \fi
}

% Processing blocks function of footnotes (block vs quad).
\newcommand{\EC@printnotes}[4]{
	\ifvoid#1\else
	\setbox\@outputbox\vbox{%
		\unvbox\@outputbox
		\ifprev@notes@printed 
		\vskip\betweenapparatusglue
		\else 
		\vskip\beforeapparatusglue
		\fi
		\nointerlineskip
		\vbox{#3}%
		\nointerlineskip
		\comparedisplay{#2}{quad}{%Quad mode.
			\begingroup
			\setbox4=\vbox{%
				\unvbox#1%
				\EC@makehboxofhboxes
			}%
			\endgroup
			\setbox0=\hbox{\unhbox\footbox@temp \EC@removehboxes}%
			\vbox{%
				\hsize=\textwidth
				\footfontsize
				%
				\leftskip=0pt\relax
				\rightskip=0pt\relax
				\parfillskip=0pt plus 1fil\relax
				%
				\parindent=\csuse{foot#4parindent}%
				\hangindent=\csuse{foot#4hangindent}%
				\hangafter=1
				\selectfont
				\unhbox0\par
			}%
		}{%
			% Block mode.
			\begingroup
			\footfontsize
			\vbox{%
				\hsize=\textwidth
				\leftskip=0pt\relax
				\rightskip=0pt\relax
				\parfillskip=0pt plus 1fil\relax
				%
				\parindent=\csuse{foot#4parindent}%
				\hangindent=\csuse{foot#4hangindent}%
				\hangafter=1
				\selectfont
				\unvbox#1%
			}%
			\endgroup
		}%
	}%
	\global\prev@notes@printedtrue
	\fi
}

%
\newcommand{\EC@printlocalnotes@worker}[4]{%
	\ifvoid#1\else
	\ifprev@notes@printed 
	\vskip\betweenapparatusglue
	\else 
	\vskip\beforeapparatusglue
	\fi
	\nointerlineskip
	\vbox{#3}%
	\nointerlineskip
	\comparedisplay{#2}{quad}{%
		\begingroup
		\setbox4=\vbox{%
			\unvbox#1%
			\EC@makehboxofhboxes
		}%
		\endgroup
		\setbox0=\hbox{\unhbox\footbox@temp \EC@removehboxes}%
		\vbox{%
			\hsize=\textwidth
			\footfontsize
			\leftskip=0pt\relax
			\rightskip=0pt\relax
			\parfillskip=0pt plus 1fil\relax
			\parindent=\csuse{foot#4parindent}%
			\hangindent=\csuse{foot#4hangindent}%
			\hangafter=1
			\selectfont
			\unhbox0\par
		}%
	}{%
		\begingroup
		\footfontsize
		\vbox{%
			\hsize=\textwidth
			\leftskip=0pt\relax
			\rightskip=0pt\relax
			\parfillskip=0pt plus 1fil\relax
			%
			\parindent=\csuse{foot#4parindent}%
			\hangindent=\csuse{foot#4hangindent}%
			\hangafter=1
			\selectfont
			\unvbox#1%
		}%
		\endgroup
	}%
	\global\prev@notes@printedtrue
	\fi
}

\newcommand{\EC@printlocalnotes}{%
	\global\prev@notes@printedfalse
	\global\let\last@printed@line\@empty
	\begingroup
	\footfontsize\selectfont
	\EC@printlocalnotes@worker{\local@footTbox}{\EC@display@T}{\footTrule}{T}%
	\EC@printlocalnotes@worker{\local@footAbox}{\EC@display@A}{\footArule}{A}%
	\EC@printlocalnotes@worker{\local@footEbox}{\EC@display@E}{\footErule}{E}%
	\endgroup
}

% Output routine.
\newcommand*{\simplecritical@doextrafeet}{%
	\global\prev@notes@printedfalse
	\global\let\last@printed@line\@empty % Resets duplicated lines detector in each pages.
	% 1- Testimonia/witnesses (footT).
	\EC@printnotes{\footTins}{\EC@display@T}{\footTrule}{T}%
	% 2- Apparatus criticus (footA).
	\EC@printnotes{\footAins}{\EC@display@A}{\footArule}{A}%
	% 3- Explicatio/explanation, conventional footnote use (footE).
	\EC@printnotes{\footEins}{\EC@display@E}{\footErule}{E}%
}

% Output routine integration.
\AtBeginDocument{%
	\EC@savedparindent=\parindent % Captures previous indentation defined for user.
	
	% A dynamic evaluation of each foot entry indentation.
	\ifcsstring{footT@useparindent}{false}%
	{\footTparindent=0pt}%
	{\footTparindent=\EC@savedparindent}%
	
	\ifcsstring{footA@useparindent}{false}%
	{\footAparindent=0pt}%
	{\footAparindent=\EC@savedparindent}%
	
	\ifcsstring{footE@useparindent}{false}%
	{\footEparindent=0pt}%
	{\footEparindent=\EC@savedparindent}%
	
	\EC@setfudge{\EC@fudgefactor}{\textwidth} %
	
	\count\footAins=1000
	\dimen\footAins=0.7\textheight
	\skip\footAins=\beforeapparatusglue
	
	\count\footTins=1000
	\dimen\footTins=0.7\textheight
	\skip\footTins=\beforeapparatusglue
	
	\count\footEins=1000
	\dimen\footEins=0.7\textheight
	\skip\footEins=\beforeapparatusglue
	
	% Output.
	\patchcmd{\@makecol}%
	{\ifvbox\@kludgeins}%
	{\simplecritical@doextrafeet\ifvbox\@kludgeins}%
	{}%
	{}%
}

