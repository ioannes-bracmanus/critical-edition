%
\newcommand{\scFootAAssoc}[3]{% #1 = bnumcount, #2 = footA_count, #3 = space
	\csxdef{footA@line@#1@#2}{\csuse{EC@line@#1}}%
	\csgappto{line@footA@trigger@#1@\csuse{EC@line@#1}}{%
		\begingroup
		\edef\thisbnum{#1}%
		\setbox0=\hbox{\footfontsize\print@footA@entry{\thisbnum}{#2}}%
		\dp0=0pt\relax
		\ht0=\EC@fudgefactor\wd0\relax
		\ifbool{incritgroup}{%
			\global\setbox\local@footAbox=\vbox{%
				\unvbox\local@footAbox
				\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
				\box0
			}%
		}{%
			\insert\footAins{%
				\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt%
				\box0
				\penalty -50 %
			}%
		}%
		\endgroup
	}%
}

\newcommand{\scFootTAssoc}[3]{% #1 = bnumcount, #2 = footT_count, #3 = space
	\csxdef{footT@line@#1@#2}{\csuse{EC@line@#1}}%
	\csgappto{line@footT@trigger@#1@\csuse{EC@line@#1}}{%
		\comparedisplay{\EC@display@T}{quad}%
		{%
			\begingroup
			\edef\thisbnum{#1}%
			\setbox0=\hbox{\footfontsize\EC@noteTitem{\print@footT@marker{\thisbnum}{#2}}{\csuse{footT@text@\thisbnum @#2}}}%
			\dp0=0pt\relax
			\ht0=\EC@fudgefactor\wd0\relax
			\ifbool{incritgroup}{%
				\global\setbox\local@footTbox=\vbox{%
					\unvbox\local@footTbox
					\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
					\box0
				}%
			}{%
				\insert\footTins{\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\box0\penalty -50}%
			}%
			\endgroup
		}%
		{%
			\begingroup
			\edef\thisbnum{#1}%
			\ifbool{incritgroup}{%
				\global\setbox\local@footTbox=\vbox{%
					\unvbox\local@footTbox
					\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
					\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footTparindent\hangindent=\footThangindent\EC@noteTitem{\print@footT@marker{\thisbnum}{#2}}{\csuse{footT@text@\thisbnum @#2}}%
				}%
			}{%
				\insert\footTins{%
					\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footTparindent\hangindent=\footThangindent
					\vskip 2pt %
					\EC@noteTitem{\print@footT@marker{\thisbnum}{#2}}{\csuse{footT@text@\thisbnum @#2}}%
				}%
			}%
			\endgroup
		}%
	}%
}

