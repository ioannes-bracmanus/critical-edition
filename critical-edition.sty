\newcommand*{\CE@setfudge}[2]{% #1 =save factor, #2 = coll width
	\begingroup
	\dimen0=\baselineskip
	\multiply\dimen0 by 1024\relax
	\divide\dimen0 by #2\relax
	\multiply\dimen0 by \footfudgefiddle\relax%
	\xdef#1{\strip@pt\dimen0}%
	\endgroup
}

% Quad format compiling.
\newcommand*{\CE@makehboxofhboxes}{%
	\global\setbox\CE@footbox@temp=\hbox{}%
	\loop
	\unpenalty\unskip\unkern
	\setbox2=\lastbox
	\ifhbox2
	\global\setbox\CE@footbox@temp=\hbox{\box2 \unhbox\CE@footbox@temp}%
	\repeat
}

\newcommand*{\CE@removehboxes}{%
	\setbox0=\lastbox
	\ifhbox0{\CE@removehboxes}\unhbox0 \fi
}

% Processing blocks function of footnotes (block vs quad).
\newcommand{\CE@printnotes}[4]{%
	\ifvoid#1\else
	\setbox\@outputbox\vbox{%
		\unvbox\@outputbox
		\ifCE@prev@notes@printed 
		\vskip\betweenapparatusglue
		\else 
		\vskip\beforeapparatusglue
		\fi
		\nointerlineskip
		\vbox{#3}%
		\nointerlineskip
		\comparedisplay{#2}{quad}{% Quad mode.
			\begingroup
			\setbox4=\vbox{%
				\unvbox#1%
				\CE@makehboxofhboxes
			}%
			\endgroup
			\setbox0=\hbox{\unhbox\CE@footbox@temp \CE@removehboxes}%
			\vbox{%
				\hsize=\textwidth
				\footfontsize
				\leftskip=0pt\relax
				\rightskip=0pt\relax
				\parfillskip=0pt plus 1fil\relax
				\parindent=\csuse{foot#4parindent}%
				\hangindent=\csuse{foot#4hangindent}%
				\hangafter=1
				\selectfont
				\unhbox0\par
			}%
		}{% Block mode.
			\begingroup
			\footfontsize
			\vbox{%
				\hsize=\textwidth
				\leftskip=0pt\relax
				\rightskip=0pt\relax
				\parfillskip=0pt plus 1fil\relax
				\parindent=\csuse{foot#4parindent}%
				\hangindent=\csuse{foot#4hangindent}%
				\hangafter=1
				\selectfont
				\unvbox#1%
			}%
			\endgroup
		}%
	}%
	\global\CE@prev@notes@printedtrue
	\fi
}

\newcommand{\CE@printlocalnotes@worker}[4]{%
	\ifvoid#1\else
	\ifCE@prev@notes@printed 
	\vskip\betweenapparatusglue
	\else 
	\vskip\beforeapparatusglue
	\fi
	\nointerlineskip
	\vbox{#3}%
	\nointerlineskip
	\comparedisplay{#2}{quad}{%
		\begingroup
		\setbox4=\vbox{%
			\unvbox#1%
			\CE@makehboxofhboxes
		}%
		\endgroup
		\setbox0=\hbox{\unhbox\CE@footbox@temp \CE@removehboxes}%
		\vbox{%
			\hsize=\textwidth
			\footfontsize
			\leftskip=0pt\relax
			\rightskip=0pt\relax
			\parfillskip=0pt plus 1fil\relax
			\parindent=\csuse{foot#4parindent}%
			\hangindent=\csuse{foot#4hangindent}%
			\hangafter=1
			\selectfont
			\unhbox0\par
		}%
	}{%
		\begingroup
		\footfontsize
		\vbox{%
			\hsize=\textwidth
			\leftskip=0pt\relax
			\rightskip=0pt\relax
			\parfillskip=0pt plus 1fil\relax
			\parindent=\csuse{foot#4parindent}%
			\hangindent=\csuse{foot#4hangindent}%
			\hangafter=1
			\selectfont
			\unvbox#1%
		}%
		\endgroup
	}%
	\global\CE@prev@notes@printedtrue
	\fi
}

\newcommand{\CE@printlocalnotes}{%
	\global\CE@prev@notes@printedfalse
	\global\let\CE@last@printed@line\@empty
	\begingroup
	\footfontsize\selectfont
	\CE@printlocalnotes@worker{\CE@local@footTbox}{\CE@display@T}{\footTrule}{T}%
	\CE@printlocalnotes@worker{\CE@local@footAbox}{\CE@display@A}{\footArule}{A}%
	\CE@printlocalnotes@worker{\CE@local@footEbox}{\CE@display@E}{\footErule}{E}%
	\endgroup
}

% Output routine.
\newcommand*{\simplecritical@doextrafeet}{%
	\global\CE@prev@notes@printedfalse
	\global\let\CE@last@printed@line\@empty
	\CE@printnotes{\footTins}{\CE@display@T}{\footTrule}{T}%
	\CE@printnotes{\footAins}{\CE@display@A}{\footArule}{A}%
	\CE@printnotes{\footEins}{\CE@display@E}{\footErule}{E}%
}

% Output routine integration.
\AtBeginDocument{%
	\CE@savedparindent=\parindent
	
	\ifcsstring{footT@useparindent}{false}%
	{\footTparindent=0pt}%
	{\footTparindent=\CE@savedparindent}%
	
	\ifcsstring{footA@useparindent}{false}%
	{\footAparindent=0pt}%
	{\footAparindent=\CE@savedparindent}%
	
	\ifcsstring{footE@useparindent}{false}%
	{\footEparindent=0pt}%
	{\footEparindent=\CE@savedparindent}%
	
	\CE@setfudge{\CE@fudgefactor}{\textwidth}%
	
	\count\footAins=1000
	\dimen\footAins=\footAheight\relax
	\skip\footAins=\beforeapparatusglue
	
	\count\footTins=1000
	\dimen\footTins=\footTheight\relax
	\skip\footTins=\beforeapparatusglue
	
	\count\footEins=1000
	\dimen\footEins=\footEheight\relax
	\skip\footEins=\beforeapparatusglue
	
	\patchcmd{\@makecol}%
	{\ifvbox\@kludgeins}%
	{\simplecritical@doextrafeet\ifvbox\@kludgeins}%
	{}%
	{}%
}

