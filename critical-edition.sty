% Checking dynamic ubication of margin numbers.
\newcommand{\checklinemargin}{%
	\toggletrue{lineonleft}%
	\ifcsdef{EC@linepage@\the\bnumcount @\the\line@num}{%
		\edef\EC@thispage{\csuse{EC@linepage@\the\bnumcount @\the\line@num}}%
	}{%
		\edef\EC@thispage{\thepage}%
	}%
	\ifdefstring{\EC@linenummargin}{right}{\togglefalse{lineonleft}}{}%
	\ifdefstring{\EC@linenummargin}{inner}{%
		\ifodd\EC@thispage\relax%
		\toggletrue{lineonleft}%
		\else%
		\togglefalse{lineonleft}%
		\fi%
	}{}%
	\ifdefstring{\EC@linenummargin}{outer}{%
		\ifodd\EC@thispage\relax%
		\togglefalse{lineonleft}%
		\else%
		\toggletrue{lineonleft}%
		\fi%
	}{}%
}

