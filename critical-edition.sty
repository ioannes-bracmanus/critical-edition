\newcount\CE@chunkcount
\newbox\CE@dummybox
\newbox\CE@stackpatchA
\newbox\CE@stackpatchAA

\newcommand{\CE@stackset}[1]{%
	\ifcase#1\or
	\global\setbox\CE@stackpatchA=\box\CE@one@line\or
	\global\setbox\CE@stackpatchAA=\box\CE@one@line\fi
}
\newcommand{\CE@stackget}[1]{%
	\ifcase#1\or
	\global\setbox\CE@one@line=\box\CE@stackpatchA\or
	\global\setbox\CE@one@line=\box\CE@stackpatchAA\fi
}
\newcommand{\CE@drainchunk}{%
	\unskip\unpenalty\unkern
	\global\setbox\CE@one@line=\lastbox
	\ifvoid\CE@one@line
	\else
	\global\advance\CE@chunkcount by 1\relax
	\CE@stackset{\the\CE@chunkcount}%
	\CE@drainchunk
	\fi
}
\newcommand{\CE@printchunk}{%
	\ifnum\CE@chunkcount>0\relax
	\CE@stackget{\the\CE@chunkcount}%
	\global\advance\CE@absline@num by 1\relax
	\global\advance\CE@line@num by 1\relax
	\print@line
	\global\advance\CE@chunkcount by -1\relax
	\CE@printchunk
	\fi
}

\newcommand{\nstart}{% Open the numbered paragraph environment
	\par
	\global\booltrue{CE@numberedpar}%
	\global\setbox\CE@rawtext=\vbox\bgroup
	\hsize=\textwidth
	\parindent=\CE@savedparindent
	\parskip=\z@\relax
	\lineskiplimit=-1000pt
	\normalbaselines
	\topskip=\z@
	\brokenpenalty=\z@
	\clubpenalty=\z@
	\displaywidowpenalty=\z@
	\interlinepenalty=\z@
	\predisplaypenalty=\z@
	\postdisplaypenalty=\z@
	\widowpenalty=\z@
}

\newcommand{\nend}{% Close the numbered paragraph environment.
	\par
	\egroup 
	\global\boolfalse{CE@numberedpar}%
	\begingroup
	\vbadness=10000
	\loop\ifvbox\CE@rawtext
	{\splittopskip=\z@ 
		\global\setbox\CE@one@line=\vsplit\CE@rawtext to \baselineskip}%
	\CE@chunkcount=0\relax
	\setbox\CE@dummybox=\vbox{%
		\unvbox\CE@one@line
		\CE@drainchunk
	}%
	\CE@printchunk
	\repeat
	\endgroup
}

