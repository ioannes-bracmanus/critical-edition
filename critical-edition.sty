\newcommand{\scFootAAssoc}[3]{% #1 = bnumcount, #2 = footA_count, #3 = space
	\csxdef{footA@line@#1@#2}{\csuse{CE@line@#1}}%
	\csgappto{line@footA@trigger@#1@\csuse{CE@line@#1}}{%
		\begingroup
		\edef\thisbnum{#1}%
		\setbox0=\hbox{\footfontsize\print@footA@entry{\thisbnum}{#2}}%
		\dp0=0pt\relax
		\ht0=\CE@fudgefactor\wd0\relax
		\ifbool{CE@incritgroup}{%
			\global\setbox\CE@local@footAbox=\vbox{%
				\unvbox\CE@local@footAbox
				\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
				\box0
			}%
		}{%
			\insert\footAins{%
				\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt%
				\box0
				\penalty -50 %
			}%
		}%
		\endgroup
	}%
}

\newcommand{\scFootTAssoc}[3]{% #1 = bnumcount, #2 = footT_count, #3 = space
