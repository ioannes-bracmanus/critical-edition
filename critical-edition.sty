		\comparedisplay{\CE@display@T}{quad}%
		{%
			\begingroup
			\edef\thisbnum{#1}%
			\setbox0=\hbox{\footfontsize\CE@noteTitem{\print@footT@marker{\thisbnum}{#2}}{\csuse{footT@text@\thisbnum @#2}}}%
			\dp0=0pt\relax
			\ht0=\CE@fudgefactor\wd0\relax
			\ifbool{CE@incritgroup}{%
				\global\setbox\CE@local@footTbox=\vbox{%
					\unvbox\CE@local@footTbox
					\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
					\box0
				}%
			}{%
				\insert\footTins{\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\box0\penalty -50}%
			}%
			\endgroup
		}%
		{%
			\begingroup
			\edef\thisbnum{#1}%
			\ifbool{CE@incritgroup}{%
				\global\setbox\CE@local@footTbox=\vbox{%
					\unvbox\CE@local@footTbox
					\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
					\leftskip=0pt\relax\rightskip=0pt\relax\parfillskip=0pt plus 1fil\relax\hsize=\textwidth\footfontsize\parindent=\footTparindent\hangindent=\footThangindent\CE@noteTitem{\print@footT@marker{\thisbnum}{#2}}{\csuse{footT@text@\thisbnum @#2}}%
				}%
