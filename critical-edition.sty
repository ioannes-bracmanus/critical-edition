}

% "critgroup" enviroment for isolated footnotes in differents critical editions of fragments.
\newenvironment{critgroup}{%
	\edef\CE@saved@footT{\the\value{footT}}%
	\edef\CE@saved@footE{\the\value{footE}}%
	\setcounter{footT}{0}% Reset counters locally in critgroup.
	\setcounter{footE}{0}%
	\global\setbox\CE@local@footTbox=\box\voidb@x
	\global\setbox\CE@local@footAbox=\box\voidb@x
	\global\setbox\CE@local@footEbox=\box\voidb@x
	\ifdefempty{\CE@grouplinenummargin}{}{%
		\let\CE@linenummargin\CE@grouplinenummargin
	}%
	\ifbool{CE@group@nummarginsep@set}{%
		\leftlinenumsep=\groupleftlinenumsep
		\rightlinenumsep=\grouprightlinenumsep
	}{}%
	\let\normal@insert\insert
	\long\def\insert##1##2{%
		\ifx##1\footTins
		\global\setbox\CE@local@footTbox=\vbox{%
			\unvbox\CE@local@footTbox
			\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
			##2%
		}%
		\else\ifx##1\footAins
		\global\setbox\CE@local@footAbox=\vbox{%
			\unvbox\CE@local@footAbox
			\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
			##2%
		}%
		\else\ifx##1\footEins
		\global\setbox\CE@local@footEbox=\vbox{%
			\unvbox\CE@local@footEbox
			\baselineskip=0pt\lineskip=0pt\lineskiplimit=-1000pt\parskip=0pt\relax
			##2%
		}%
		\else
		\normal@insert##1{##2}%
		\fi\fi\fi
	}%
}{%
	\par
	\CE@printlocalnotes
	\setcounter{footT}{\CE@saved@footT}%
	\setcounter{footE}{\CE@saved@footE}%
}
